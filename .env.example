# Skopiuj do `.env` i uzupełnij wartościami. `.env` jest w .gitignore.
# NIGDY nie wpisuj tu prawdziwych wartości — ten plik jest w repozytorium.

# Connection string z puli Supavisor Supabase, tryb "transaction".
# Panel Supabase -> Connect -> Transaction pooler.
DATABASE_URL=

# --- Poniższe NIE są jeszcze używane (Faza 2, logowanie Auth.js) ---
