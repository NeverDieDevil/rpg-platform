# Skopiuj do `.env` i uzupełnij wartościami. `.env` jest w .gitignore.
# NIGDY nie wpisuj tu prawdziwych wartości — ten plik jest w repozytorium.

# Connection string z puli Supavisor Supabase, tryb "transaction" (port 6543).
# Panel Supabase -> Connect -> Transaction pooler.
# Host konczy sie na .pooler.supabase.com, uzytkownik to postgres.<ref>.
DATABASE_URL=

# Opcjonalny: ten sam adres w trybie "session" (port 5432) — uzywany wylacznie
# do migracji, bo tryb transaction nie trzyma stanu sesji. Lokalnie mozesz go
# pominac; w CI ustawia go sekret MIGRATIONS_DATABASE_URL.
# MIGRATIONS_DATABASE_URL=

# --- Poniższe NIE są jeszcze używane (Faza 2, logowanie Auth.js) ---
# Trzymane tutaj jako zapowiedź, żeby lista wymaganych sekretów była w jednym miejscu.
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=
